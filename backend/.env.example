# Copiar a .env (NO se versiona) o exportar como variables de entorno.
PORT=3000
# Secreto para firmar los JWT. Generar uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-caracteres
# Vida del token (segundos)
JWT_TTL_SECONDS=86400
# Credenciales de la consola web de administración (/console)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contraseña
# Ruta del archivo SQLite del servidor
DB_PATH=./data/cloud.db
